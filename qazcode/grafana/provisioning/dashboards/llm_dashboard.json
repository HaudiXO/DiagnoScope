{
  "title": "LLM Observability & API Metrics",
  "panels": [
    {
      "type": "stat",
      "title": "Total LLM Tokens Generated",
      "targets": [
        {
          "expr": "sum(llm_token_usage_total)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "LLM Generation Latency (s)",
      "targets": [
        {
          "expr": "rate(llm_generation_duration_seconds_sum[5m]) / rate(llm_generation_duration_seconds_count[5m])",
          "legendFormat": "Avg Latency",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "LLM Errors",
      "targets": [
        {
          "expr": "sum(llm_errors_total)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Total API Requests",
      "targets": [
        {
          "expr": "sum(http_requests_total)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "API Request Duration (p95)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95 API Latency",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 8
      }
    }
  ],
  "schemaVersion": 38,
  "refresh": "5s"
}