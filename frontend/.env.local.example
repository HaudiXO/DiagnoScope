# Frontend Environment Variables
#
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real secrets.

# Base URL of the Python backend API.
# Default points to the local FastAPI/mock server.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Set to "true" to bypass the backend entirely and use local fixture data.
# Useful for UI demos when no backend is running.
# Set to "false" (or leave empty) to use the live backend.
NEXT_PUBLIC_USE_MOCK=false

# Request timeout in milliseconds (default: 10000).
NEXT_PUBLIC_REQUEST_TIMEOUT_MS=10000
